  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "You\u2019re almost ready to share! Before you do, add some details for your game directly on Unity Play: a title, description, and a thumbnail, if you like.\n\nIt\u2019s also a good idea to test one more time, to make sure that everything works as expected.\n\n<b>Your journey doesn't end here:</b>\n\n\u2022 When you\u2019re ready, share the link so others can play your game!"
