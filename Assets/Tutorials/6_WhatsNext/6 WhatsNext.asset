  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "In the Junior Programmer pathway, you'll learn how to code in a Unity project, even if you're new to programming:\n\n\u2022 Move and control GameObjects with code\n\u2022 Implement gameplay mechanics, sound, and more\n\u2022 Learn programming fundamentals \n\u2022 Prepare for certification and programming jobs\n\n"
