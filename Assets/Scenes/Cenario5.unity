  m_Script: {fileID: 11500000, guid: e9d5da7bac6f0f9489d55302b1e866d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Salas.ObjectSpot
  reachX: 1.6
  minFeetDy: -0.45
  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 2.9}
  id: mesaChefe
  available: 1
  first:
  - speaker: kai
    text: "<i>Meu nome. Meu desligamento. Ele ia me demitir sem avisar ningu\xE9m.</i>"
  - speaker: kai
    text: "<i>\"A chave reserva fica junto dos pap\xE9is de demiss\xE3o.\"</i>"
  again:
  - speaker: kai
    text: "<i>Arquivo de demiss\xF5es. \xC9 l\xE1 que est\xE1 a chave.</i>"
  docTitle: MEMORANDO INTERNO
  docBody: "Para: Setor de Opera\xE7\xF5es\nDe: Dire\xE7\xE3o\n\nO funcion\xE1rio K. ser\xE1 desligado ao fim do m\xEAs. <b>N\xE3o avisar antes.</b>\n\nOs pap\xE9is ficam no arquivo de <b>DEMISS\xD5ES</b>, junto da chave reserva da sala. Ningu\xE9m procura l\xE1."
  docFooter: 'Assinado: o Diretor.'
  docOnlyOnce: 0
  openVisual: {fileID: 0}
  sfx: {fileID: 1594504443}
  useClip: {fileID: 8300000, guid: 80a8ff741b0e28b46ac209c2b38b50f4, type: 3}
