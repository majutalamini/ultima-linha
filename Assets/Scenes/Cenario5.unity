MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1492531389}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cc748eb2f452f84896b7e5da8c026e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Salas.BodyCrossing
  player: {fileID: 1066901444}
  x0: 23
  x1: 27.1
  head: {fileID: 957497595}
  headX: 26.56
  headRoll: 1.15
  sfx: {fileID: 526057237}
  squelch:
  - {fileID: 8300000, guid: 7e90913b46752b149bdd5b7a11d9a0df, type: 3}
  - {fileID: 8300000, guid: 1a0b1b5e0a6e87642b3f638ad54bc9d9, type: 3}
  - {fileID: 8300000, guid: f8532b0ecc2f82f40a5164b2e03f53a1, type: 3}
  headClip: {fileID: 8300000, guid: ef2a3764e00469e41b3ff96b4f73b8cb, type: 3}
  stepDistance: 0.55
  firstSticky:
  - speaker: kai
    text: "<i>O ch\xE3o gruda nos sapatos. \xC9 sangue. Ainda est\xE1 mole.</i>"
  headLoose:
  - speaker: kai
    text: "<i>A cabe\xE7a... se soltou do corpo.</i>"
  - speaker: kai
    text: "<i>N\xE3o estava presa a nada. Desde quando ele est\xE1 assim?</i>"
--- !u!114 &1492531392
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1492531389}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9d5da7bac6f0f9489d55302b1e866d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Salas.ObjectSpot
  reachX: 2.3
  minFeetDy: -0.45
  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 1.5}
  id: corpo
  available: 1
  first:
  - speaker: kai
    text: "<i>No bolso dele, uma alavanca de ferro. A que faltava no painel l\xE1 embaixo.</i>"
  - speaker: kai
    text: <i>E esse recorte...</i>
  - speaker: kai
    text: "<i>N\xE3o. Eu lembro da discuss\xE3o. Eu lembro da mesa. Eu lembro das minhas m\xE3os.</i>"
  - speaker: kai
    text: <i>Foi o que eu fiz.</i>
  again:
  - speaker: kai
    text: "<i>Eu n\xE3o quero mais olhar para ele.</i>"
  docTitle: "JORNAL DA MANH\xC3"
  docBody: "<b>EXECUTIVO \xC9 ENCONTRADO MORTO NO PR\xD3PRIO ESCRIT\xD3RIO</b>\n\nO diretor da empresa foi encontrado sem vida na noite de ter\xE7a-feira. A pol\xEDcia procura um funcion\xE1rio do setor de opera\xE7\xF5es, identificado como <b>Kai</b>, visto discutindo com a v\xEDtima poucas horas antes.\n\nSegundo colegas, Kai havia sido avisado de que seria demitido naquela semana. Ele n\xE3o foi mais visto desde ent\xE3o."
  docFooter: "Recorte dobrado ao meio, achado no bolso do palet\xF3."
  docOnlyOnce: 0
  openVisual: {fileID: 0}
  sfx: {fileID: 0}
  useClip: {fileID: 0}
