  - {fileID: 432791051}
  - {fileID: 1208194103}
  - {fileID: 566771100}
  - {fileID: 1698186179}
  keyCabinetId: arquivoC
  keyPickup: {fileID: 454973323}
  cabinetGlow: {fileID: 575568632}
  keyGlow: {fileID: 1216452284}
  door: {fileID: 659394556}
  deskX: 17.9
  doorX: 33.4
  kaiBodyX: 23.55
  gravity: {x: 0, y: -20}
  nextScene: Cenario6
  menuScene: MainMenu
  redTint: {fileID: 718928995}
  tintAlpha: 0.28
  ambience: {fileID: 1854149348}
  ambienceVolume: 0.5
  heartbeat: {fileID: 232498835}
  sfx: {fileID: 1594504443}
  gunTakeClip: {fileID: 8300000, guid: 39efc0c8924617a458bbc7d76361f5e3, type: 3}
  gunCockClip: {fileID: 8300000, guid: 95498dd29318d1f43acead75cb7ab85e, type: 3}
  doorSlamClip: {fileID: 8300000, guid: 78ea10b49a3e16f498c68be99f16abb9, type: 3}
  doorLockClip: {fileID: 8300000, guid: c0f76583a76b40c458469b73c7827a87, type: 3}
  knockClip: {fileID: 8300000, guid: 96959c1d8095e3844810c2737fe46ca6, type: 3}
  keyClip: {fileID: 8300000, guid: a03d2f18b078e484fa776420ede12714, type: 3}
  leverClip: {fileID: 8300000, guid: ac80d2cfcf5e1c9478f98173ac2bcf90, type: 3}
  objectiveBody: Examine o corpo.
  objectiveKey: "Ache a chave da porta. Vasculhe o escrit\xF3rio."
  objectiveTakeKey: Pegue a chave na gaveta do arquivo.
  objectiveDoor: "Abra a porta do escrit\xF3rio."
  intro:
  - speaker: kai
    text: <i>Essa porta de vidro fosco. Esse corredor.</i>
  - speaker: souta
    text: "Kai... tem um homem no ch\xE3o, atr\xE1s da mesa."
  - speaker: ren
    text: "Ele n\xE3o est\xE1 se mexendo. E aquilo no ch\xE3o \xE9... sangue?"
  - speaker: kai
    text: "<i>Eu conhe\xE7o esse escrit\xF3rio. Eu conhe\xE7o essa mesa.</i>"
  - speaker: souta
    text: "V\xEA se ele tem algo no bolso. Um documento, qualquer coisa que diga quem \xE9."
  - speaker: kai
    text: <i>...Por que sou eu que tenho que olhar?</i>
  doorBeforeBody:
  - speaker: kai
    text: "<i>Antes de sair, eu preciso saber quem \xE9 ele.</i>"
  confront1:
  - speaker: ren
    text: "Kai... isso \xE9 o seu nome? Aqui, no jornal."
  - speaker: souta
    text: "Me d\xE1 isso. ...\"Procura-se funcion\xE1rio Kai.\""
  - speaker: souta
    text: "Voc\xEA matou ele."
  - speaker: kai
    text: "Eu... eu n\xE3o lembro. Souta, eu n\xE3o..."
  - speaker: ren
    text: "A gente confiou em voc\xEA! Desde o vag\xE3o, desde o come\xE7o!"
  - speaker: souta
    text: "Voc\xEA vivia dizendo que ele pegava no seu p\xE9. Mas matar...?"
  confront2:
  - speaker: souta
    text: Ele guardava uma arma na gaveta da mesa. Eu sabia.
  - speaker: ren
    text: "Souta, n\xE3o! A gente n\xE3o precisa disso!"
  - speaker: souta
    text: "Fica onde est\xE1, Kai. M\xE3os onde eu possa ver."
  - speaker: kai
    text: Souta, abaixa isso. Sou eu.
  - speaker: souta
    text: Foi o que o chefe deve ter dito.
  confront3:
  - speaker: ren
    text: "Eu s\xF3 quero ir embora... Eu tenho medo de voc\xEA, Kai."
  - speaker: souta
    text: "A gente vai buscar ajuda. Voc\xEA fica aqui."
  - speaker: kai
    text: "Esperem! N\xE3o me deixem aqui!"
  afterLock:
  - speaker: kai
    text: <i>Trancaram. Pelo lado de fora.</i>
  - speaker: kai
    text: "<i>Eles t\xEAm raz\xE3o em ter medo. Eu tamb\xE9m tenho.</i>"
  - speaker: kai
    text: <i>A chave tem que estar em algum lugar. O chefe guardava tudo nesses arquivos e nessa mesa.</i>
  renOutside:
  - speaker: ren
    text: "<i>(do outro lado da porta)</i> Kai... a gente vai chamar algu\xE9m. Fica quieto, por favor."
  - speaker: kai
    text: "<i>Ren... eu juro que eu n\xE3o sabia.</i>"
  cabinetHint:
  - speaker: kai
    text: "<i>Nenhuma chave nesses arquivos. S\xF3 falta o de demiss\xF5es.</i>"
  - speaker: kai
    text: "<i>Se ele escondesse algo, seria junto da minha pr\xF3pria demiss\xE3o.</i>"
  doorNoKey:
  - speaker: kai
    text: <i>Trancada por fora. Preciso da chave.</i>
  keyFound:
  - speaker: kai
    text: "<i>Achei. A chave reserva, escondida junto da minha pr\xF3pria demiss\xE3o.</i>"
  - speaker: kai
    text: <i>Agora preciso sair. Com a alavanca no bolso... o trem ainda espera.</i>
  doorUnlocked:
  - speaker: kai
    text: "<i>Destrancada. Do outro lado, eles est\xE3o me esperando.</i>"
  - speaker: kai
    text: <i>Eu preciso colocar a alavanca no painel antes que me achem.</i>
  endTitle: "FIM DO CEN\xC1RIO 5"
  endSubtitle: "A esta\xE7\xE3o ainda espera pela alavanca."
