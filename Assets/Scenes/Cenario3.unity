  id: maquina
  available: 1
  first:
  - speaker: kai
    text: "<i>A m\xE1quina engoliu a moeda... e cuspiu uma pe\xE7a de trilho.</i>"
  again:
  - speaker: kai
    text: "<i>A m\xE1quina n\xE3o tem mais nada.</i>"
  docTitle: "RECIBO DA M\xC1QUINA"
  docBody: "<b>M\xC1QUINA AUTOM\xC1TICA</b>\n1 \xE1gua\nTotal: pago.\n\n<i>Impresso embaixo, em letras mi\xFAdas:</i>\ntroco: uma pe\xE7a de trilho."
  docFooter: "A pe\xE7a caiu na bandeja, junto com a garrafa e o recibo."
  docOnlyOnce: 1
  openVisual: {fileID: 0}
  sfx: {fileID: 2048951284}
