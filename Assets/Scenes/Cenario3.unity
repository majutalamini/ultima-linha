MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1554170587}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1472af4a818587747bc49cf08e00f679, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Salas.Cenario3Director
  player: {fileID: 1463189828}
  cameraFollow: {fileID: 1972167279}
  souta: {fileID: 1333641432}
  ren: {fileID: 1198593365}
  documents:
  - {fileID: 1568673773}
  - {fileID: 778348263}
  - {fileID: 860177496}
  - {fileID: 643914901}
  door: {fileID: 1007216017}
  panel: {fileID: 1596466410}
  docGlows:
  - {fileID: 873001979}
  - {fileID: 2067578885}
  - {fileID: 1431833894}
  - {fileID: 612020724}
  renGivesLast:
  - speaker: ren
    text: "Kai, espera! Eu achei isso no ch\xE3o, perto dos caixotes."
  - speaker: ren
    text: "\xC9 um peda\xE7o de trilho. \xC9 o que est\xE1 faltando no painel?"
  - speaker: kai
    text: "<i>\xC9 a \xFAltima pe\xE7a. Agora d\xE1 para completar a linha.</i>"
  gravity: {x: 0, y: -20}
  nextScene: Cenario4
  menuScene: MainMenu
  ambience: {fileID: 232498835}
  ambienceVolume: 0.5
  sfx: {fileID: 1594504443}
  noteClip: {fileID: 8300000, guid: b195f2d308a1a2147abf2b088b25e459, type: 3}
  pieceClip: {fileID: 8300000, guid: ac80d2cfcf5e1c9478f98173ac2bcf90, type: 3}
  objectiveFind: "Ache as pe\xE7as que faltam no painel de desvios. Est\xE3o espalhadas pela esta\xE7\xE3o."
  objectiveDoor: Complete a linha no painel ao lado da porta.
  intro:
  - speaker: kai
    text: "<i>Uma esta\xE7\xE3o. Vazia, com as luzes ainda acesas.</i>"
  - speaker: souta
    text: "Acabou o trilho do vag\xE3o. A sa\xEDda \xE9 por aquela porta, no fundo."
  - speaker: ren
    text: "Est\xE1 trancada. Do lado tem um painel com um desenho dos trilhos."
  - speaker: kai
    text: "<i>Um painel de desvios. E est\xE1 faltando peda\xE7o.</i>"
  allFound:
  - speaker: kai
    text: "<i>Quatro pe\xE7as. Agora \xE9 encaixar no painel e girar os trilhos at\xE9 a luz chegar na porta.</i>"
  doorClosed:
  - speaker: kai
    text: "<i>O painel mostra os trilhos da esta\xE7\xE3o. A luz sai da plataforma e tem que chegar at\xE9 a administra\xE7\xE3o.</i>"
  - speaker: kai
    text: "<i>Mas est\xE3o faltando pe\xE7as. Sem elas a linha nunca fecha.</i>"
  doorUnlocked:
  - speaker: kai
    text: <i>A linha acendeu inteira. A porta destravou.</i>
  - speaker: souta
    text: "Vai. A gente vem logo atr\xE1s."
  endTitle: "FIM DO CEN\xC1RIO 3"
  endSubtitle: "A sala de controle ainda est\xE1 sendo constru\xEDda."
