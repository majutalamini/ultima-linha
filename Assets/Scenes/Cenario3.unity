  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Salas.ObjectSpot
  reachX: 1.6
  minFeetDy: -0.45
  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 3.2}
  id: horarios
  available: 1
  first:
  - speaker: kai
    text: "<i>Uma pe\xE7a de trilho, do tamanho da m\xE3o. Arrancada de algum painel.</i>"
  - speaker: kai
    text: "<i>\"Sem a linha completa, a porta n\xE3o abre.\" Ent\xE3o tem mais pe\xE7as por a\xED.</i>"
  again:
  - speaker: kai
    text: "<i>O quadro de hor\xE1rios. J\xE1 peguei a pe\xE7a.</i>"
  docTitle: "QUADRO DE HOR\xC1RIOS"
  docBody: "<b>ESTA\xC7\xC3O \u2014 LINHA \xDANICA</b>\n\nPartidas, todas as noites:\n22:10   \xB7   23:00   \xB7   23:50\n\nDepois do \xFAltimo trem, a esta\xE7\xE3o \xE9 fechada e a administra\xE7\xE3o tranca a sala de controle.\n\n<i>Escrito a l\xE1pis, na margem:</i>\nTirei as pe\xE7as do painel de desvios. Sem a linha completa, a porta da administra\xE7\xE3o n\xE3o abre."
  docFooter: "Atr\xE1s da folha, presa com fita: uma pe\xE7a de trilho."
  docOnlyOnce: 0
  openVisual: {fileID: 0}
  sfx: {fileID: 1594504443}
  useClip: {fileID: 8300000, guid: b195f2d308a1a2147abf2b088b25e459, type: 3}
