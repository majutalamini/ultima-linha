--- !u!114 &1666633459
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1666633458}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1472af4a818587747bc49cf08e00f679, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Salas.Cenario3Director
  player: {fileID: 1803188294}
  cameraFollow: {fileID: 1071831109}
  souta: {fileID: 299118503}
  ren: {fileID: 331518993}
  soutaSpots:
  - {x: 12.427586, y: 0.6003946, z: 0}
  - {x: 53.55, y: 0.6003946, z: 0}
  - {x: 75.21896, y: 0.6003946, z: 0}
  renSpots:
  - {x: 13.627586, y: 0.6003946, z: 0}
  - {x: 57.35, y: 0.6003946, z: 0}
  - {x: 73.91896, y: 0.6003946, z: 0}
  portaTrem: {fileID: 1516326820}
  portao: {fileID: 317072774}
  portaoGrade: {fileID: 602269097}
  portaoBloqueio: {fileID: 1434442400}
  portaoCorre: 2.3844826
  lockUI: {fileID: 673005335}
  codigo: 2350
  armadilha: 0417
  portaoClip: {fileID: 8300000, guid: 8bf2b53e0da366b4296e6b0430d28d7b, type: 3}
  moeda: {fileID: 2064181492}
  moedaVisual: {fileID: 1164618469}
  maquina: {fileID: 160267678}
  documents:
  - {fileID: 1241535995}
  - {fileID: 1639763547}
  - {fileID: 160267678}
  - {fileID: 781995810}
  door: {fileID: 1187040890}
  panel: {fileID: 656961799}
  painelApagado: {fileID: 1552317687}
  painelAceso: {fileID: 341920799}
  docGlows:
  - {fileID: 993530733}
  - {fileID: 1521406951}
  - {fileID: 1926580599}
  - {fileID: 991410364}
  - {fileID: 2126910462}
  renGivesLast:
  - speaker: ren
    text: "Kai, espera! Eu achei isso no ch\xE3o, perto dos caixotes."
  - speaker: ren
    text: "\xC9 um peda\xE7o de trilho. \xC9 o que est\xE1 faltando no painel?"
  - speaker: kai
    text: "<i>\xC9 a \xFAltima pe\xE7a. Agora d\xE1 para completar a linha.</i>"
  gravity: {x: 0, y: -20}
  nextScene: Cenario4
  menuScene: MainMenu
  ambience: {fileID: 1615401729}
  ambienceVolume: 0.5
  sfx: {fileID: 2048951284}
  noteClip: {fileID: 8300000, guid: b195f2d308a1a2147abf2b088b25e459, type: 3}
  pieceClip: {fileID: 8300000, guid: ac80d2cfcf5e1c9478f98173ac2bcf90, type: 3}
  coinClip: {fileID: 8300000, guid: a03d2f18b078e484fa776420ede12714, type: 3}
  dicaSegundos: 75
  dicaToast: Talvez o Souta ou o Ren saibam de alguma coisa.
  objectiveGate: "Abra o port\xE3o de servi\xE7o no fim da plataforma."
  objectiveFind: "Ache as pe\xE7as que faltam no painel de desvios."
  objectiveDoor: "Complete a linha no painel ao lado da porta da administra\xE7\xE3o."
  intro:
  - speaker: kai
    text: "<i>A esta\xE7\xE3o que eu vi pela janela. Vazia, com as luzes ainda acesas.</i>"
  - speaker: ren
    text: A porta do trem... fechou sozinha.
  - speaker: souta
    text: "Melhor. Ningu\xE9m volta para aquele trem."
  - speaker: souta
    text: "Tem um port\xE3o no fim da plataforma. A sa\xEDda deve ser por ali."
  - speaker: kai
    text: "<i>Terminal. Mas o trem n\xE3o devia ter parado aqui.</i>"
  portaoPrimeiro:
  - speaker: kai
    text: "<i>O hor\xE1rio da \xFAltima partida. Est\xE1 no quadro, l\xE1 atr\xE1s.</i>"
  codigoErrado:
  - speaker: kai
    text: "<i>N\xE3o \xE9 esse. O hor\xE1rio da \xFAltima partida est\xE1 no quadro.</i>"
  codigoArmadilha:
  - speaker: kai
    text: "<i>N\xE3o abriu.</i>"
  - speaker: kai
    text: "<i>Quatro e dezessete n\xE3o \xE9 partida nenhuma. Algu\xE9m escreveu por cima.</i>"
  portaoAberto:
  - speaker: souta
    text: "Vinte e tr\xEAs e cinquenta. O \xFAltimo trem de verdade."
  - speaker: ren
    text: "Ent\xE3o o nosso... n\xE3o estava na lista?"
  - speaker: souta
    text: "Trem fora de hor\xE1rio. Acontece."
  - speaker: kai
    text: "<i>A letra do 04:17 \xE9 torta, apertada. Igual \xE0 do meu di\xE1rio.</i>"
  - speaker: souta
    text: "Vamos. O sagu\xE3o \xE9 por aqui."
  semMoeda:
  - speaker: kai
    text: "<i>Ela pede uma moeda. Eu n\xE3o tenho nenhuma.</i>"
  todasPecas:
  - speaker: ren
    text: "Kai... a c\xE2mera da plataforma. Tinha algu\xE9m na beira."
  - speaker: souta
    text: "Era reflexo. N\xE3o tem ningu\xE9m aqui al\xE9m de n\xF3s tr\xEAs."
  - speaker: kai
    text: "<i>N\xF3s tr\xEAs.</i>"
  - speaker: souta
    text: "A porta da administra\xE7\xE3o fica no fundo. A gente te espera l\xE1."
  doorClosed:
  - speaker: kai
    text: "<i>O painel do lado da porta mostra os trilhos da esta\xE7\xE3o. A luz sai da plataforma e tem que chegar at\xE9 a administra\xE7\xE3o.</i>"
  - speaker: kai
    text: "<i>Mas est\xE3o faltando pe\xE7as. Sem elas a linha nunca fecha.</i>"
  doorUnlocked:
  - speaker: kai
    text: <i>A linha acendeu inteira. A porta destravou.</i>
  - speaker: souta
    text: "Administra\xE7\xE3o. Se tem um jeito de fazer o trem andar de novo, \xE9 l\xE1 dentro."
  - speaker: ren
    text: "E se a gente s\xF3 esperasse o pr\xF3ximo trem?"
  - speaker: souta
    text: "Que pr\xF3ximo? O \xFAltimo foi \xE0s vinte e tr\xEAs e cinquenta."
  - speaker: kai
    text: <i>E o das quatro e dezessete.</i>
  conversaSouta:
  - falas:
    - speaker: souta
      text: "O port\xE3o tem um teclado. Deve ter o c\xF3digo em algum aviso por a\xED."
  - falas:
    - speaker: souta
      text: "Tudo aqui tem um mecanismo, Kai. At\xE9 essa esta\xE7\xE3o."
  - falas:
    - speaker: souta
      text: Depois dessa porta, nada de parar. Entendeu?
  conversaRen:
  - falas:
    - speaker: ren
      text: "Eu n\xE3o gosto de plataforma vazia. Parece que algu\xE9m vai empurrar a gente."
    - speaker: kai
      text: <i>...Por que ele disse isso?</i>
  - falas:
    - speaker: ren
      text: "Os funcion\xE1rios ficavam l\xE1 em cima, no mezanino. D\xE1 pra subir pelos caixotes."
  - falas:
    - speaker: ren
      text: "Eu fico do seu lado. Mesmo que voc\xEA n\xE3o queira."
  dicaSouta:
  - falas:
    - speaker: souta
      text: "O port\xE3o fecha depois da \xFAltima partida. O quadro pendurado diz qual foi."
  - falas:
    - speaker: souta
      text: "A m\xE1quina pede moeda. Debaixo do banco da plataforma brilhou alguma coisa."
    - speaker: souta
      text: "E l\xE1 em cima, no mezanino, tem uma mesa com gaveta."
  - falas:
    - speaker: souta
      text: "A luz entra pela plataforma e tem que sair embaixo, na administra\xE7\xE3o. Gira s\xF3 o que est\xE1 no caminho."
  dicaRen:
  - falas:
    - speaker: ren
      text: "N\xE3o o que est\xE1 escrito \xE0 m\xE3o... o que est\xE1 impresso."
  - falas:
    - speaker: ren
      text: Pra subir nos caixotes, pula de um pouco longe.
  - falas:
    - speaker: ren
      text: "Come\xE7a pela porta e volta at\xE9 a entrada."
  endTitle: "FIM DO CEN\xC1RIO 3"
  endSubtitle: "A sala de controle ainda est\xE1 sendo constru\xEDda."
