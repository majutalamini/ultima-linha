  reachX: 1.4
  minFeetDy: -0.45
  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 2.4}
  id: achados
  available: 1
  first:
  - speaker: ren
    text: "\xD3culos redondos... iguais aos meus."
  - speaker: kai
    text: <i>Iguais aos que eu usava na escola.</i>
  again:
  - speaker: kai
    text: <i>Uma moeda debaixo do banco da plataforma.</i>
  docTitle: ACHADOS E PERDIDOS
  docBody: "\xD3culos redondos, de crian\xE7a \u2014 <i>ningu\xE9m veio buscar.</i>\nGuarda-chuva preto.\nBolsa de trabalho, crach\xE1 0417 \u2014 <i>devolvida ao dono.</i>\nUma moeda, debaixo do banco da plataforma \u2014 <b>n\xE3o recolhida.</b>"
  docFooter: "Caderno de registro, com a letra de algu\xE9m que j\xE1 n\xE3o trabalha aqui."
  docOnlyOnce: 1
  openVisual: {fileID: 0}
  sfx: {fileID: 2048951284}
  useClip: {fileID: 8300000, guid: b195f2d308a1a2147abf2b088b25e459, type: 3}
