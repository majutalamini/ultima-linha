  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 3.5}
  id: comunicado
  available: 1
  first:
  - speaker: kai
    text: <i>Sala 704. A mensagem do celular.</i>
  - speaker: kai
    text: "<i>O pr\xE9dio tem sete andares. Eu contei.</i>"
  again:
  - speaker: kai
    text: <i>Desligamento.</i>
  docTitle: COMUNICADO INTERNO
  docBody: "<b>Reestrutura\xE7\xE3o do setor de opera\xE7\xF5es.</b>\n\nOs funcion\xE1rios abaixo devem comparecer \xE0 <b>sala 704</b> (7\xBA andar), \xE0s 9h, para tratar do seu desligamento:\n\nA. Hayashi\nM. Ono\n<b>K.</b>\nT. Sato\n\n\u2014 A Dire\xE7\xE3o"
  docFooter: "Colado por dentro do vidro da bilheteria. Algu\xE9m circulou o \"K.\" de caneta."
  docOnlyOnce: 1
  openVisual: {fileID: 0}
  sfx: {fileID: 2048951284}
  useClip: {fileID: 8300000, guid: b195f2d308a1a2147abf2b088b25e459, type: 3}
