  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d92f0ece4f85bd448d0608b4b04d9b7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Cenario1.Cenario1Director
  player: {fileID: 1810902146}
  puzzle: {fileID: 1813839376}
  door: {fileID: 1330139851}
  cameraFollow: {fileID: 1420122443}
  souta: {fileID: 1215142450}
  ren: {fileID: 594972648}
  letterPuzzle: {fileID: 714634284}
  portaEntrada: {fileID: 1966210886}
  entradaInicio: {x: -1.5517259, y: 2.2203946, z: 0}
  entradaDentro: 2.3758621
  conversaX: 8.2434845
  boundsEntrada:
    serializedVersion: 2
    x: -26.951725
    y: 0
    width: 29.027588
    height: 9.310345
  boundsVagao:
    serializedVersion: 2
    x: -2.551724
    y: 0
    width: 37.81434
    height: 9.310345
  entradaTrancada:
  - speaker: kai
    text: "<i>Trancou atr\xE1s de mim.</i>"
  - speaker: kai
    text: "<i>N\xE3o tem volta.</i>"
  emperrada: {fileID: 138593312}
  dicaErros: 2
  dicaSegundos: 75
  dicaToast: Talvez o Souta ou o Ren saibam de alguma coisa.
  introCutscene: {fileID: 1845189427}
  playIntroCutscene: 0
  gravity: {x: 0, y: -20}
  nextScene: Cenario2
  menuScene: MainMenu
  ambience: {fileID: 930407050}
  ambienceVolume: 0.55
  objectiveStart: "Descubra como sair do vag\xE3o."
  objectiveLevers: "Puxe as tr\xEAs alavancas na ordem que o letreiro mostra."
  objectiveLetters: "Encontre as letras escritas pelo vag\xE3o."
  objectiveWord: Digite a palavra na trava da porta do fundo.
  objectiveExit: A porta do fundo abriu.
  intro:
  - speaker: ren
    text: E se a gente nunca mais sair daqui?
  - speaker: souta
    text: "A gente sai. Tudo tem um mecanismo. \xC9 s\xF3 entender a l\xF3gica."
  - speaker: ren
    text: "Voc\xEA fala isso at\xE9 no escrit\xF3rio."
  - speaker: souta
    text: E sempre funciona.
  - speaker: ren
    text: "...Ouviu isso? A porta l\xE1 de tr\xE1s bateu."
  - speaker: souta
    text: Kai?
  - speaker: kai
    text: "<i>Souta. E... quem \xE9 o outro?</i>"
  doorLocked:
  - speaker: kai
    text: "<i>Trancada. A luz vermelha em cima dela n\xE3o apaga.</i>"
  firstFail:
  - speaker: kai
    text: <i>Ordem errada. As alavancas voltaram sozinhas.</i>
  - speaker: kai
    text: <i>Preciso olhar o letreiro de novo.</i>
  lettersAppear:
  - speaker: kai
    text: <i>As luzes...</i>
  - speaker: kai
    text: "<i>Tem alguma coisa escrita pelo vag\xE3o. Em vermelho.</i>"
  - speaker: kai
    text: "<i>Isso n\xE3o estava aqui antes.</i>"
  doorNeedsWord:
  - speaker: kai
    text: <i>A luz ficou laranja. Uma trava abriu... mas tem outra.</i>
  - speaker: kai
    text: "<i>Um painel pedindo letras. Cinco espa\xE7os.</i>"
  allLetters:
  - speaker: kai
    text: "<i>Achei todas. Cinco letras, cinco espa\xE7os na trava.</i>"
  - speaker: kai
    text: "<i>...Eu j\xE1 sei que palavra elas formam.</i>"
  wordSolved:
  - speaker: kai
    text: <i>M... O... R... T... E.</i>
  - speaker: kai
    text: <i>Morte.</i>
  - speaker: kai
    text: <i>Quem escreveu isso?</i>
  solved:
  - speaker: kai
    text: <i>Abriu.</i>
  - speaker: kai
    text: "<i>O pr\xF3ximo vag\xE3o est\xE1 escuro...</i>"
  endTitle: "FIM DO CEN\xC1RIO 1"
  endSubtitle: "O pr\xF3ximo vag\xE3o ainda est\xE1 sendo constru\xEDdo."
