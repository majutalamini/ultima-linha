--- !u!114 &1326427341
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1326427340}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d92f0ece4f85bd448d0608b4b04d9b7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Cenario1.Cenario1Director
  player: {fileID: 1822151652}
  puzzle: {fileID: 1536068788}
  door: {fileID: 1743825506}
  cameraFollow: {fileID: 22029611}
  souta: {fileID: 377196554}
  ren: {fileID: 983646688}
  letterPuzzle: {fileID: 683944454}
  introCutscene: {fileID: 1280846641}
  playIntroCutscene: 1
  gravity: {x: 0, y: -20}
  nextScene: Cenario2
  menuScene: MainMenu
  ambience: {fileID: 1425708508}
  ambienceVolume: 0.55
  objectiveStart: "Descubra como sair do vag\xE3o."
  objectiveLevers: "Puxe as tr\xEAs alavancas na ordem que o letreiro mostra."
  objectiveLetters: "Encontre as letras escritas pelo vag\xE3o."
  objectiveWord: Digite a palavra na trava da porta do fundo.
  objectiveExit: A porta do fundo abriu.
  intro:
  - speaker: kai
    text: <i>...</i>
  - speaker: kai
    text: <i>Peguei no sono no trem de novo.</i>
  - speaker: kai
    text: "<i>Parado no meio do t\xFAnel. E essas luzes...</i>"
  - speaker: kai
    text: "<i>\"Pr\xF3xima parada: terminal.\" Que horas s\xE3o?</i>"
  doorLocked:
  - speaker: kai
    text: "<i>Trancada. A luz vermelha em cima dela n\xE3o apaga.</i>"
  firstFail:
  - speaker: kai
    text: <i>Ordem errada. As alavancas voltaram sozinhas.</i>
  - speaker: kai
    text: <i>Preciso olhar o letreiro de novo.</i>
  lettersAppear:
  - speaker: kai
    text: <i>As luzes...</i>
  - speaker: kai
    text: "<i>Tem alguma coisa escrita pelo vag\xE3o. Em vermelho.</i>"
  - speaker: kai
    text: "<i>Isso n\xE3o estava aqui antes.</i>"
  doorNeedsWord:
  - speaker: kai
    text: <i>A luz ficou laranja. Uma trava abriu... mas tem outra.</i>
  - speaker: kai
    text: "<i>Um painel pedindo letras. Cinco espa\xE7os.</i>"
  allLetters:
  - speaker: kai
    text: "<i>Achei todas. Cinco letras, cinco espa\xE7os na trava.</i>"
  - speaker: kai
    text: "<i>...Eu j\xE1 sei que palavra elas formam.</i>"
  wordSolved:
  - speaker: kai
    text: <i>M... O... R... T... E.</i>
  - speaker: kai
    text: <i>Morte.</i>
  - speaker: kai
    text: <i>Quem escreveu isso?</i>
  solved:
  - speaker: kai
    text: <i>Abriu.</i>
  - speaker: kai
    text: "<i>O pr\xF3ximo vag\xE3o est\xE1 escuro...</i>"
  endTitle: "FIM DO CEN\xC1RIO 1"
  endSubtitle: "O pr\xF3ximo vag\xE3o ainda est\xE1 sendo constru\xEDdo."
