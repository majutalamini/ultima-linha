  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 069cd05f31fc21d488e1dc73936c7370, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Cenario1.NpcTalk
  reachX: 1.7
  minFeetDy: -0.45
  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 4.45}
  rig: {fileID: 619493757}
  sprite: {fileID: 0}
  lookAt: {fileID: 1486247126}
  puzzle: {fileID: 1362720920}
  door: {fileID: 554402527}
  firstTalk:
  - speaker: souta
    text: "Kai. Voc\xEA estava no vag\xE3o de tr\xE1s?"
  - speaker: kai
    text: "Acordei l\xE1. Sozinho. O vag\xE3o estava cheio quando eu dormi."
  - speaker: souta
    text: "Cheio? Estamos s\xF3 n\xF3s tr\xEAs aqui desde a esta\xE7\xE3o. O trem parou faz uns vinte minutos e n\xE3o andou mais."
  - speaker: souta
    text: "As portas laterais n\xE3o abrem. A do fundo do vag\xE3o tem uma trava ligada a tr\xEAs alavancas."
  - speaker: souta
    text: "Repara no letreiro em cima das portas. Ele acende numa ordem e depois apaga. N\xE3o \xE9 defeito."
  - speaker: kai
    text: "<i>Claro que ele j\xE1 descobriu tudo. Como sempre.</i>"
  repeatTalk:
  - speaker: souta
    text: "Tr\xEAs luzes no letreiro: esquerda, meio, direita. Cada uma \xE9 uma alavanca."
  - speaker: souta
    text: "Puxe na mesma ordem em que elas acendem. N\xE3o \xE9 dif\xEDcil, Kai."
  afterSolved:
  - speaker: souta
    text: As luzes apagaram por um segundo. Quando voltaram, isso estava escrito por todo lado.
  - speaker: souta
    text: "A porta ainda tem uma segunda trava. Cinco espa\xE7os. Junte as letras das paredes."
  - speaker: kai
    text: "<i>Ele fala como se fosse s\xF3 mais uma tarefa do escrit\xF3rio.</i>"
  afterDoor:
  - speaker: souta
    text: "Viu? Quando voc\xEA presta aten\xE7\xE3o, voc\xEA consegue."
  - speaker: kai
    text: <i>...Por que isso soa igual a uma bronca do chefe?</i>
  hintLevers:
  - speaker: souta
    text: Kai. Para de puxar no chute.
  - speaker: souta
    text: "O letreiro acende primeiro o MEIO, depois a ESQUERDA, depois a DIREITA. \xC9 essa a ordem."
  - speaker: souta
    text: "E a da esquerda est\xE1 emperrada. Solta ela antes de come\xE7ar."
  hintLetters:
  - speaker: souta
    text: "Procura onde voc\xEA ainda n\xE3o olhou. Ch\xE3o, janelas, portas."
  - speaker: souta
    text: "Uma est\xE1 na porta por onde voc\xEA entrou. Outra no vidro, alto: sobe no encosto."
  balao:
  - {fileID: 1876861685}
  - {fileID: 691609308}
  - {fileID: 745402676}
  breathAmount: 0.008
  breathSpeed: 1.6
