  m_Script: {fileID: 11500000, guid: e9d5da7bac6f0f9489d55302b1e866d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Salas.ObjectSpot
  reachX: 1.6
  minFeetDy: -0.45
  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 4.4}
  id: mapa
  available: 1
  first:
  - speaker: kai
    text: "<i>Essas esta\xE7\xF5es... n\xE3o existem. S\xE3o lugares meus.</i>"
  - speaker: kai
    text: "<i>E esse trem n\xE3o para em nenhum deles.</i>"
  again:
  - speaker: kai
    text: "<i>Todas riscadas, menos a \xFAltima.</i>"
  docTitle: MAPA DA LINHA
  docBody: "<b>EMPRESA</b>  \u2014  <b>CL\xCDNICA DR. MORI</b>  \u2014  <b>APARTAMENTO 12</b>  \u2014  <b>ESCOLA</b>  \u2014  <b>HOSPITAL</b>  \u2014  ...\n\nA linha vermelha sai da empresa e passa por todo lugar onde eu j\xE1 estive.\n\nA \xFAltima bolinha n\xE3o tem nome. Embaixo dela, \xE0 m\xE3o: <b>\xDALTIMA LINHA</b>."
  docFooter: "Algu\xE9m riscou as esta\xE7\xF5es de tr\xE1s, uma por uma."
  docOnlyOnce: 1
  openVisual: {fileID: 0}
  sfx: {fileID: 775720770}
  useClip: {fileID: 8300000, guid: b195f2d308a1a2147abf2b088b25e459, type: 3}
