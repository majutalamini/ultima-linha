  m_Script: {fileID: 11500000, guid: e9d5da7bac6f0f9489d55302b1e866d2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Salas.ObjectSpot
  reachX: 1.2
  minFeetDy: -0.45
  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 1.2}
  id: celular
  available: 1
  first:
  - speaker: kai
    text: "<i>Esse celular \xE9... igual ao meu.</i>"
  - speaker: kai
    text: "<i>Sala 704. A reuni\xE3o com o chefe. Est\xE1 no meu di\xE1rio.</i>"
  again:
  - speaker: kai
    text: "<i>Onze chamadas. A \xFAltima \xE0s quatro e dezessete.</i>"
  docTitle: "CELULAR CA\xCDDO"
  docBody: "<b>11 chamadas perdidas</b>: Chefe\n\n\xDAltima mensagem, <b>04:17</b>:\n<i>\"Kai, preciso falar com voc\xEA. Amanh\xE3, 9h, sala 704. N\xE3o falte.\"</i>\n\nRascunho n\xE3o enviado:\n<i>\"eu n\xE3o vou\"</i>"
  docFooter: "A tela est\xE1 rachada. A bateria n\xE3o acaba."
  docOnlyOnce: 1
  openVisual: {fileID: 0}
  sfx: {fileID: 128810948}
  useClip: {fileID: 8300000, guid: b195f2d308a1a2147abf2b088b25e459, type: 3}
