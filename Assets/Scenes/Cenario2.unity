  reachX: 1.3
  minFeetDy: -0.45
  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 2.8}
  id: bolsa
  available: 1
  first:
  - speaker: kai
    text: "<i>Meu crach\xE1. Minha bolsa. No bagageiro de um vag\xE3o em que eu nunca entrei.</i>"
  - speaker: kai
    text: "<i>0417... O n\xFAmero \xE9 o meu. N\xE3o o do Ren.</i>"
  again:
  - speaker: kai
    text: "<i>J\xE1 peguei o fus\xEDvel daqui.</i>"
  docTitle: "BOLSA COM CRACH\xC1"
  docBody: "<b>KAI</b>\nOpera\xE7\xF5es  \xB7  Mesa 12\nFuncion\xE1rio n\xBA <b>0417</b>\n\nA foto do crach\xE1 foi riscada de caneta at\xE9 rasgar o pl\xE1stico."
  docFooter: "Dentro da bolsa, junto dos pap\xE9is: um fus\xEDvel."
  docOnlyOnce: 1
  openVisual: {fileID: 0}
  sfx: {fileID: 775720770}
  useClip: {fileID: 8300000, guid: b195f2d308a1a2147abf2b088b25e459, type: 3}
