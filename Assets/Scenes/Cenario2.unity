  - speaker: kai
    text: <i>Vazio.</i>
  - speaker: kai
    text: "<i>Faz tr\xEAs semanas. Eu estou bem. Eu estou bem.</i>"
  again:
  - speaker: kai
    text: "<i>J\xE1 peguei o fus\xEDvel daqui.</i>"
  docTitle: "FRASCO DE REM\xC9DIO"
  docBody: "<b>Paciente:</b> Kai\n<b>M\xE9dico:</b> Dr. Mori\n\nTomar 1 comprimido \xE0s <b>8h</b> e \xE0s <b>20h</b>.\n<b>N\xE3o interromper sem orienta\xE7\xE3o m\xE9dica.</b>"
  docFooter: "Vazio. A tampa rolou para baixo do banco, junto de um fus\xEDvel."
  docOnlyOnce: 1
  openVisual: {fileID: 0}
