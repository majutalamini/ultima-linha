  escuroVagao3: 0.5
  escrita: {fileID: 1871482013}
  ligaClip: {fileID: 8300000, guid: 36db145671e199b4d81798ef852564a0, type: 3}
  pegaClip: {fileID: 8300000, guid: a03d2f18b078e484fa776420ede12714, type: 3}
  gravity: {x: 0, y: -20}
  nextScene: Cenario3
