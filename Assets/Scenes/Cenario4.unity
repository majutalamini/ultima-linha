  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58c75d4af44d34846b9061a7f466ceb3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UltimaLinha.Salas.Cenario4Director
  player: {fileID: 1463189828}
  cameraFollow: {fileID: 1789344203}
  souta: {fileID: 1573120480}
  ren: {fileID: 1457191522}
  levers:
  - {fileID: 1055003923}
  - {fileID: 709604775}
  - {fileID: 2034144966}
  emptySocket: {fileID: 564954089}
  clock: {fileID: 2008226181}
  note: {fileID: 2008324712}
  drawer: {fileID: 876381619}
  generator: {fileID: 0}
  door: {fileID: 1050133019}
  lockUI: {fileID: 1062558969}
  code: 0417
  redTint: {fileID: 578545878}
  heartbeat: {fileID: 232498835}
  clockX: 12.5
  darkness: {fileID: 639656311}
  darkAlpha: 0.5
  emergencyLights:
  - {fileID: 2067578885}
  - {fileID: 1431833894}
  - {fileID: 1118444091}
  - {fileID: 2061908103}
  gravity: {x: 0, y: -20}
  nextScene: Cenario5
  menuScene: MainMenu
  ambience: {fileID: 612020725}
  ambienceVolume: 0.5
  hum: {fileID: 1854149348}
  humVolume: 0.45
  sfx: {fileID: 1594504443}
  powerOnClip: {fileID: 8300000, guid: 36db145671e199b4d81798ef852564a0, type: 3}
  keyClip: {fileID: 8300000, guid: a03d2f18b078e484fa776420ede12714, type: 3}
  drawerClip: {fileID: 8300000, guid: 80a8ff741b0e28b46ac209c2b38b50f4, type: 3}
  emptyClip: {fileID: 8300000, guid: 3b9636e29f5114947948cf66af1fc637, type: 3}
  objectivePower: 'Reative a energia: deixe as alavancas levantadas.'
  objectiveKey: Ache a chave da porta. A gaveta da mesa tem um cadeado.
  objectiveDoor: Abra a porta da sala.
  objectiveClock: "Olhe o rel\xF3gio da parede: a senha \xE9 a hora em que ele parou."
  objectiveCode: "Abra a gaveta: a senha \xE9 04:17, sem os dois pontos."
  intro:
  - speaker: kai
    text: "<i>A sala de controle. \xC9 daqui que o trem sai.</i>"
  - speaker: souta
    text: Painel de energia, gerador, tudo apagado. Se a gente religar isso, o trem volta a andar de verdade.
  - speaker: ren
    text: "E se ele n\xE3o parar mais? Eu n\xE3o gosto desse zumbido."
  - speaker: souta
    text: Quatro encaixes de alavanca. Todas precisam ficar levantadas.
  - speaker: kai
    text: "<i>Eu s\xF3 vejo tr\xEAs alavancas: uma no ch\xE3o, uma na passarela e uma em cima do gerador.</i>"
  - speaker: souta
    text: "Ent\xE3o falta uma. A gente acha depois. Primeiro a energia, depois a porta."
  leverHalf:
  - speaker: kai
    text: "<i>Uma levantada. O painel ainda est\xE1 morto. Faltam as outras duas.</i>"
  powerOn:
  - speaker: souta
    text: Luz! O gerador pegou.
  - speaker: kai
    text: "<i>Tr\xEAs acesas. O quarto encaixe continua escuro.</i>"
  - speaker: ren
    text: "A porta de servi\xE7o ligou, mas a trava \xE9 por chave. Procura uma, Kai."
  - speaker: souta
    text: O supervisor guardava tudo naquela mesa. Olha a gaveta.
  drawerOpened:
  - speaker: kai
    text: "<i>Uma chave. A etiqueta diz \"SA\xCDDA T\xC9CNICA\".</i>"
  - speaker: souta
    text: "Quatro e dezessete. Quem diria que era s\xF3 olhar a parede."
  soutaClock:
  - speaker: souta
    text: Quatro e dezessete.
  - speaker: souta
    text: "\xC9 nessa hora, Kai. \xC0s quatro e dezessete todos n\xF3s vamos morrer."
  - speaker: souta
    text: "Voc\xEA, eu, o Ren. Ningu\xE9m sai da \xFAltima plataforma. O rel\xF3gio parou para avisar a gente."
  - speaker: ren
    text: "Souta...? Do que voc\xEA est\xE1 falando?"
  - speaker: kai
    text: "<i>Os olhos dele est\xE3o vazios. Ele nem pisca.</i>"
  - speaker: souta
    text: Quatro e dezessete. Quatro e dezessete. Quatro e...
  soutaForgets:
  - speaker: souta
    text: "...H\xE3? O que foi? Por que voc\xEAs est\xE3o me olhando assim?"
  - speaker: ren
    text: "Voc\xEA acabou de dizer que a gente vai morrer, Souta."
  - speaker: souta
    text: "Eu? Eu n\xE3o disse nada disso. Esse lugar est\xE1 mexendo com a cabe\xE7a de voc\xEAs."
  - speaker: souta
    text: "Enfim... o rel\xF3gio parou \xE0s quatro e dezessete. Deve servir para alguma coisa."
  - speaker: kai
    text: "<i>04:17. A senha da gaveta \xE9 a hora em que o rel\xF3gio parou.</i>"
  drawerNoClue:
  - speaker: kai
    text: "<i>Um cadeado de quatro n\xFAmeros. Eu n\xE3o fa\xE7o ideia da senha.</i>"
  - speaker: kai
    text: <i>Tem um bilhete preso na parede. Talvez explique.</i>
  drawerNeedClock:
  - speaker: kai
    text: "<i>O bilhete diz que a senha \xE9 a hora em que o rel\xF3gio parou.</i>"
  - speaker: kai
    text: "<i>Primeiro eu preciso olhar o rel\xF3gio.</i>"
  doorNoPower:
  - speaker: kai
    text: "<i>A porta n\xE3o responde. Sem energia, nada abre aqui.</i>"
  doorNoKey:
  - speaker: kai
    text: "<i>Tem energia, mas a trava \xE9 mec\xE2nica. Preciso da chave.</i>"
  doorUnlocked:
  - speaker: souta
    text: Abriu. Vamos, Kai.
  - speaker: ren
    text: "O que ser\xE1 que tem do outro lado?"
  - speaker: kai
    text: "<i>Esse corredor... eu j\xE1 andei por ele. Eu sei aonde ele leva.</i>"
  endTitle: "FIM DO CEN\xC1RIO 4"
  endSubtitle: "O escrit\xF3rio ainda est\xE1 sendo constru\xEDdo."
