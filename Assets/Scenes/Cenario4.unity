  reachX: 1.3
  minFeetDy: -0.45
  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 3.3}
  id: bilhete
  available: 1
  first:
  - speaker: kai
    text: "<i>O rel\xF3gio da parede. A senha \xE9 a hora em que ele parou.</i>"
  again:
  - speaker: kai
    text: "<i>A hora em que o rel\xF3gio parou, sem os dois pontos.</i>"
  docTitle: REGISTRO DE TURNO
  docBody: "Turno da noite. Supervisor: M. Takeda.\n\nA gaveta da mesa fica trancada com <b>cadeado de combina\xE7\xE3o</b>.\n\nA senha \xE9 a <b>hora em que o rel\xF3gio da parede parou</b>, na noite em que faltou energia. Quatro n\xFAmeros, sem os dois pontos.\n\nN\xE3o anote a senha em lugar nenhum. Olhe o rel\xF3gio."
  docFooter: Folha arrancada de um caderno, presa na parede com um alfinete vermelho.
  docOnlyOnce: 0
  openVisual: {fileID: 0}
  sfx: {fileID: 0}
  useClip: {fileID: 0}
