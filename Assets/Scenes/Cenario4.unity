  reachX: 1.3
  minFeetDy: -0.45
  maxFeetDy: 0.6
  promptOffset: {x: 0, y: 3.2}
  id: encaixe
  available: 1
  first:
  - speaker: kai
    text: "<i>Quatro encaixes no painel. Eu s\xF3 tenho tr\xEAs alavancas aqui.</i>"
  - speaker: kai
    text: "<i>A que falta est\xE1 em outro lugar. Se eu a achar, volto aqui.</i>"
  again:
  - speaker: kai
    text: <i>O quarto encaixe continua vazio. Preciso achar a alavanca.</i>
  docTitle: 
  docBody: 
  docFooter: 
