  - 20.5
  - 31.5
  - 42.5
  - 52.5
  spawnY: 2.53
  countdownSeconds: 70
  gravity: {x: 0, y: -20}
  timerText: {fileID: 1827783288}
  redTint: {fileID: 100413383}
  nextScene: Cenario7
  menuScene: MainMenu
  ambience: {fileID: 293875048}
  alarm: {fileID: 486311992}
  sfx: {fileID: 545128395}
  activateClip: {fileID: 8300000, guid: cbf9b49f34e802843bdcea37cf956906, type: 3}
  tickClip: {fileID: 8300000, guid: 01c04179eac7cb241b954ce9a545aee9, type: 3}
  crushClip: {fileID: 8300000, guid: 54c020254c684cc47b82e7f31274142d, type: 3}
  timeoutClip: {fileID: 8300000, guid: ff7024c5be4fcd74c843d338db36e7fb, type: 3}
  objectiveSocket: Encaixe a alavanca no painel.
  objectiveRun: "Corra at\xE9 o metr\xF4 antes que o tempo acabe."
  intro:
  - speaker: kai
    text: "<i>Corredor de servi\xE7o. O painel de tra\xE7\xE3o, com o encaixe vazio.</i>"
  - speaker: kai
    text: "<i>A alavanca que estava no bolso dele ainda est\xE1 comigo. \xC9 isso que faltava para o trem andar.</i>"
  inserted:
  - speaker: kai
    text: "<i>O metr\xF4 est\xE1 ligando. D\xE1 para sentir no ch\xE3o.</i>"
  - speaker: kai
    text: <i>E o painel marcou um tempo. Pouco tempo.</i>
  - speaker: kai
    text: "<i>Ele est\xE1 l\xE1 no come\xE7o da linha. Eu preciso chegar antes que ele parta. Corre!</i>"
  firstCrush:
  - speaker: kai
    text: "<i>As anteparas est\xE3o fechando no ritmo do alarme. Eu preciso passar na hora que a luz fica verde.</i>"
  timeout:
  - speaker: kai
    text: <i>O trem esperou. Eu ainda tenho outra chance.</i>
  doorBefore:
  - speaker: kai
    text: "<i>O metr\xF4 ainda n\xE3o est\xE1 pronto. Preciso encaixar a alavanca no painel.</i>"
  boarding:
  - speaker: kai
    text: "<i>O metr\xF4. O mesmo vag\xE3o do come\xE7o.</i>"
  - speaker: kai
    text: <i>Falta pouco.</i>
  endTitle: "FIM DO CEN\xC1RIO 6"
  endSubtitle: "A plataforma final ainda est\xE1 sendo constru\xEDda."
