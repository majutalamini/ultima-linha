  sombraSentado: {fileID: 94309037}
  vaoInicio: {x: 36.362072, y: 2.2203946, z: 0}
  boundsVagao:
    serializedVersion: 2
    x: 0
    y: 0
    width: 46.941383
    height: 9.310345
  inicioVao: 36.16207
  quedaY: -1.8996054
  chegadaX: 42.663795
  descansoX: 43.313797
  bordaVao: 37.913795
  gravity: {x: 0, y: -20}
  ambience: {fileID: 935224325}
  sfx: {fileID: 1809616410}
  piscaClip: {fileID: 8300000, guid: edebb6e095029854fb9cd96a5a0a7430, type: 3}
  freioClip: {fileID: 8300000, guid: 21e10a09fe786944e96c97fb70cbda0b, type: 3}
  nextScene: Cenario1
  menuScene: MainMenu
  acorda:
  - speaker: kai
    text: <i>...</i>
  - speaker: kai
    text: <i>Peguei no sono no trem de novo.</i>
  - speaker: kai
    text: "<i>Cad\xEA todo mundo? Agora mesmo o vag\xE3o estava cheio.</i>"
  - speaker: kai
    text: "<i>E o trem... parou. Parece que o vag\xE3o envelheceu vinte anos.</i>"
  portaTrancada:
  - speaker: kai
    text: "<i>Trancada. Tem um painel de emerg\xEAncia aqui do lado.</i>"
  antesDoPulo:
  - speaker: kai
    text: "<i>A passarela entre os vag\xF5es... n\xE3o est\xE1 aqui.</i>"
  - speaker: kai
    text: "<i>Tem luz no pr\xF3ximo vag\xE3o. E vozes.</i>"
  - speaker: kai
    text: "<i>Se eu correr, acho que alcan\xE7o.</i>"
  primeiraQueda:
  - speaker: kai
    text: "<i>Andando n\xE3o d\xE1. Preciso pegar impulso.</i>"
