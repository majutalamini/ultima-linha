    serializedVersion: 2
    x: 0
    y: -5.59
    width: 35.99
    height: 15
  darkness: {fileID: 1956527834}
  flash: {fileID: 530684216}
  choice: {fileID: 1844969966}
  news: {fileID: 1750920796}
  menuScene: MainMenu
  ambience: {fileID: 293875048}
  sfx: {fileID: 100413384}
  trainRumble: {fileID: 486311992}
  siren: {fileID: 545128395}
  pushClip: {fileID: 8300000, guid: 585d9ce3a93001d4580f861a609ef316, type: 3}
  fallClip: {fileID: 8300000, guid: 40f03c4d4e23dda45b861946d8af31b6, type: 3}
  hornClip: {fileID: 8300000, guid: 79eb665df8d55014a948c52b2959e01d, type: 3}
  shotClip: {fileID: 8300000, guid: dbed6941e1066b843af87a07506aee00, type: 3}
  bodyClip: {fileID: 8300000, guid: fdde963bd6e5c2e4ba768995946d5b2a, type: 3}
  gunDropClip: {fileID: 8300000, guid: d9fa1204dc573ec499c700e974b14dd4, type: 3}
  cockClip: {fileID: 8300000, guid: 95498dd29318d1f43acead75cb7ab85e, type: 3}
  ambulanceClip: {fileID: 8300000, guid: 2de9b4a00b3cbba4b95b9402bda397f2, type: 3}
  policeClip: {fileID: 8300000, guid: 6109375fc1d472845b6248f1c98d9b1b, type: 3}
  brakeClip: {fileID: 8300000, guid: ae76670ac63039643a945ee00cc0f848, type: 3}
  intro:
  - speaker: kai
    text: "<i>A \xFAltima plataforma. O nome est\xE1 escrito na parede: \xDALTIMA LINHA.</i>"
  - speaker: kai
    text: "<i>O rel\xF3gio daqui tamb\xE9m parou em quatro e dezessete.</i>"
  - speaker: kai
    text: "<i>O Ren est\xE1 na beira, olhando os trilhos. O Souta, logo atr\xE1s, com a arma do chefe.</i>"
  confront:
  - speaker: ren
    text: "Kai... voc\xEA veio."
  - speaker: ren
    text: "L\xE1 embaixo \xE9 fundo. Se algu\xE9m cair, n\xE3o levanta mais."
  - speaker: souta
    text: "Fica onde est\xE1, Kai. A gente sabe o que voc\xEA fez com o chefe."
  - speaker: souta
    text: "S\xE3o quatro e dezessete. Eu avisei. \xC9 a hora em que tudo acaba."
  - speaker: ren
    text: "Eu s\xF3 quero que isso termine. Do jeito que for."
  - speaker: kai
    text: "<i>Eles nunca v\xE3o me deixar em paz. Eles est\xE3o sempre aqui. Sempre.</i>"
  - speaker: kai
    text: "<i>Algu\xE9m tem que parar.</i>"
  othersStart:
  - speaker: kai
    text: Chega.
  - speaker: ren
    text: "Kai...? O que voc\xEA vai...?"
  soutaPanic:
  - speaker: souta
    text: REN!
  - speaker: souta
    text: "Voc\xEA empurrou ele! Ele bateu l\xE1 embaixo, ele n\xE3o est\xE1 se mexendo!"
  - speaker: souta
    text: Fica longe de mim! Fica longe!
  pointGun:
  - speaker: souta
    text: Kai, abaixa isso. Sou eu. Sou eu, Kai.
  - speaker: kai
    text: Eu sei.
  afterShot:
  - speaker: kai
    text: "<i>Sil\xEAncio. Finalmente, sil\xEAncio.</i>"
  - speaker: kai
    text: "<i>...Por que ainda tem algu\xE9m gritando?</i>"
  selfStart:
  - speaker: kai
    text: "N\xE3o. Voc\xEAs n\xE3o t\xEAm culpa de nada."
  - speaker: kai
    text: Quem tem que parar sou eu.
  - speaker: ren
    text: Kai? Kai, sai da beira!
  selfLast:
  - speaker: souta
    text: "O trem! Kai, o trem est\xE1 vindo!"
  - speaker: ren
    text: KAI!
  - speaker: kai
    text: <i>Desculpa.</i>
  choiceTitle: 
  choiceOptions:
  - Acabar com eles
  - Acabar comigo
  choiceNotes:
  - "Ningu\xE9m mais vai me acusar."
  - Isso termina comigo.
  policeChannel: "JORNAL DA NOITE  \xB7  PLANT\xC3O"
  policeHeadline: "FUNCION\xC1RIO \xC9 PRESO NO TRABALHO POR TENTATIVA DE MASSACRE"
  policeBody: "Kai, 27 anos, funcion\xE1rio da companhia de trens, foi preso na madrugada desta quarta-feira, por volta das 4h17, na esta\xE7\xE3o onde trabalhava. Segundo a pol\xEDcia, ele empurrou um colega para a vala dos trilhos e atirou em outro com a arma do antigo diretor da empresa, encontrado morto na semana passada.\n\nTestemunhas contam que, antes do ataque, ele conversava sozinho com duas pessoas que chamava de Souta e Ren. Os dois funcion\xE1rios feridos foram levados ao hospital."
  policeTicker: "URGENTE  \xB7  Suspeito foi detido na \xFAltima plataforma da linha  \xB7  Esta\xE7\xE3o permanece fechada  \xB7  Pol\xEDcia investiga liga\xE7\xE3o com a morte do diretor da empresa  \xB7  "
  ambulanceChannel: "JORNAL DA NOITE  \xB7  PLANT\xC3O"
  ambulanceHeadline: "TRABALHADOR TIRA A PR\xD3PRIA VIDA NO LOCAL DE TRABALHO"
  ambulanceBody: "Um funcion\xE1rio de 27 anos, identificado como Kai, morreu na madrugada desta quarta-feira, por volta das 4h17, na esta\xE7\xE3o de trem onde trabalhava. Segundo a fam\xEDlia, ele tinha esquizofrenia e havia parado o tratamento.\n\nAs c\xE2meras mostram que ele passou a noite andando sozinho pela esta\xE7\xE3o, falando com duas pessoas: Souta e Ren. N\xE3o existe nenhum registro de algu\xE9m com esses nomes. Para os m\xE9dicos, eles nunca estiveram l\xE1: eram parte da doen\xE7a."
  ambulanceTicker: "SA\xDADE MENTAL  \xB7  Se voc\xEA ou algu\xE9m pr\xF3ximo precisa conversar, ligue 188 (CVV), 24 horas, de gra\xE7a  \xB7  Esquizofrenia tem tratamento  \xB7  "
  endTitle: "\xDALTIMA LINHA"
  endSubtitleOthers: FIM
  endSubtitleSelf: FIM
